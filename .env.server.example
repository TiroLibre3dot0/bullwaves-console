# Server-side environment variables (DO NOT COMMIT real secrets)
# Used by /api/analytics/* endpoints (Plausible Stats API)
# The local upload server auto-loads env files in this order:
# .env.server.local, .env.server, .env.local, .env
# Recommended: copy this file to .env.server.local for local development.

# Plausible Stats API key (Bearer token)
PLAUSIBLE_STATS_API_KEY=

# Plausible site id (usually the tracked domain, same as VITE_PLAUSIBLE_DOMAIN)
PLAUSIBLE_SITE_ID=

# Qlik Cloud integration (server-side only)
# Recommended for production: OAuth M2M
QLIK_TENANT_URL=
QLIK_OAUTH_CLIENT_ID=
QLIK_OAUTH_CLIENT_SECRET=
QLIK_OAUTH_SCOPE=user_default

# Optional fallback for quick tests only (not recommended in production)
QLIK_API_KEY=

# Optional: Trustpilot CSV source from Google Sheets/Drive.
# Example URL:
# TRUSTPILOT_SOURCE_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit?gid=<GID>#gid=<GID>
# Modes: remote-first (default if URL is set), remote-only, local-only
TRUSTPILOT_SOURCE_URL=
TRUSTPILOT_SOURCE_MODE=remote-first

# Console authentication
# Secret key for signing session tokens. Use a long random string.
# Generate one: node -e "require('crypto').randomBytes(48).toString('hex')" | Write-Output
AUTH_SECRET=

# Admin emails (comma-separated) – these users see the "Gestione Accessi" panel
ADMIN_EMAILS=

# Credentials store for production/Vercel (JSON string, maps email -> {pwd, enabled})
# After generating passwords locally (via the admin panel), copy config/credentials.json
# contents here as a single-line JSON string.
CONSOLE_CREDENTIALS=

# Convrs API integration (server-side only)
# Keep this token secret and rotate immediately if exposed.
CONVRS_API_TOKEN=

# Optional override (default: https://data.conv.rs/api)
CONVRS_API_URL=https://data.conv.rs/api

# Optional shared secret to validate Convrs webhook/callback requests.
# Send it as header: x-convrs-webhook-secret
CONVRS_WEBHOOK_SECRET=

# SendGrid test email endpoint (server-side only)
# Required for POST /api/email/send-test
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Bullwaves
SENDGRID_UNSUBSCRIBE_GROUP_ID=
SENDGRID_EVENT_WEBHOOK_SECRET=
SENDGRID_SENDER_NAME=
SENDGRID_SENDER_ADDRESS=
SENDGRID_SENDER_CITY=
SENDGRID_SENDER_STATE=
SENDGRID_SENDER_ZIP=
# Optional recipient controls for POST /api/email/send-test:
# - default behavior (when empty): only paolo.v@bullwaves.com
# - whitelist mode: comma-separated list of allowed recipients
#   Example: SENDGRID_ALLOWED_RECIPIENTS=paolo.v@bullwaves.com,migs.dy@bullwaves.com
# - unsafe broad mode (avoid in production): allow any valid recipient
#   SENDGRID_ALLOW_ALL_RECIPIENTS=1
SENDGRID_ALLOWED_RECIPIENTS=
SENDGRID_ALLOW_ALL_RECIPIENTS=

# Required to protect POST /api/email/send-test.
# Send as Authorization: Bearer <secret> or x-sendgrid-test-secret.
SENDGRID_TEST_SECRET=

# Optional: when set, local /api/email/(health|send-test|status) calls are proxied
# to this remote base URL to keep send+tracking aligned with webhook environment.
# Example: https://bullwaves-console.vercel.app
SENDGRID_PROXY_BASE_URL=

# Dynamic Messaging SMS integration (server-side only)
# API docs: https://apidocs.dynamicmessaging.co.uk/sms-api
# Used by:
#   GET  /api/sms/health
#   POST /api/sms/send-test
#   GET  /api/sms/status/:id
DYNAMIC_SMS_API_BASE_URL=https://api.sms.dynamicmessaging.co.uk
DYNAMIC_SMS_API_KEY=
DYNAMIC_SMS_DEFAULT_SENDER=Bullwaves
# Optional recipient controls for POST /api/sms/send-test:
# - default behavior (when empty): allow any recipient
# - whitelist mode: comma-separated list of allowed recipients
#   Example: DYNAMIC_SMS_ALLOWED_RECIPIENTS=+447000000001,+447000000002
# - strict testing mode: force whitelist checks only
#   DYNAMIC_SMS_ALLOW_ALL_RECIPIENTS=0
# - unsafe broad mode (avoid in production): allow any valid recipient
#   DYNAMIC_SMS_ALLOW_ALL_RECIPIENTS=1
DYNAMIC_SMS_ALLOWED_RECIPIENTS=
DYNAMIC_SMS_ALLOW_ALL_RECIPIENTS=0

# Gmail integration (server-side only)
# Used by /api/gmail/* for inbox automation.
# Create OAuth Desktop/Web credentials in Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Local default callback for upload-server:
#   http://localhost:4000/api/gmail/oauth/callback
GMAIL_OAUTH_REDIRECT_URI=
# Optional HMAC secret to sign/verify OAuth state.
GMAIL_OAUTH_STATE_SECRET=
# Optional comma-separated scopes override.
# Defaults include gmail.readonly, gmail.modify, gmail.send
GMAIL_OAUTH_SCOPES=

# Slack Inbox integration (server-side only)
# Used by:
#   GET  /api/slack/health
#   GET  /api/slack/channels
#   GET  /api/slack/inbox
#   POST /api/slack/refresh
#   POST /api/slack/mark
# Bot token with scopes typically required:
# channels:history, channels:read, groups:history, groups:read
SLACK_BOT_TOKEN=
# Optional comma-separated channels (names with/without # or channel IDs) used as default watchlist.
# Example: sales-ops,support-live,C01ABCDEF12
SLACK_WATCH_CHANNELS=
# Optional defaults for sync behavior.
SLACK_PER_CHANNEL_LIMIT=45
SLACK_DEFAULT_CHANNEL_COUNT=8
# Optional hard gate on sensitive endpoints (channels/refresh/mark).
# When enabled, viewer email must be in ADMIN_EMAILS.
SLACK_REQUIRE_ADMIN=0

# ACUITY Trading integration
# Frontend stream lab (set these in .env.local for Vite local runs)
# VITE_ACUITY_API_KEY=
# VITE_ACUITY_TRADE_TOKEN_SALT=

# Server-side REST auth – used by acuityFetch.js to call Acuity REST API
# POST https://api.acuitytrading.com/token (grant_type=password)
# Token is cached in memory for 14 days (refreshed automatically).
# Used by:
#   GET /api/acuity/templates/preview/:id?live=1  → real data injected into HTML template
#   (future) POST /api/acuity/email/send          → send real email with live Acuity data
ACUITY_API_USERNAME=
ACUITY_API_PASSWORD=

# Cellxpert Admin API (server-side only)
# Used by:
#   GET /api/cellxpert/health
#   GET /api/cellxpert/affiliates
#   GET /api/cellxpert/registrations
#   GET /api/cellxpert/performance
#   GET /api/cellxpert/media-report.csv
#   GET /api/cellxpert/registrations-report.csv
#   GET /api/cellxpert/payments-report.csv
#   GET /api/cellxpert/affiliate-index.json
#   GET /api/cellxpert/affiliate-kpi-index.json
CELLXPERT_API_BASE_URL=https://adminapi.cellxpert.com/
CELLXPERT_ADMIN_URL=Bullwaves
CELLXPERT_ADMIN_USER=
CELLXPERT_ADMIN_PASSWORD=
